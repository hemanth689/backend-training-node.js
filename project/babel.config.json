{
    "presets": [
      ["@babel/preset-env", {
        "targets": {
          "node": "14",
          "browsers": ["> 0.25%", "not dead"]
        },
        "modules": "commonjs",
        "useBuiltIns": "usage",
        "corejs": 3
      }]
    ]
  }
/*
    targets: Define what environments you want to support.
    modules: Transforms import/export into require for Node.
    useBuiltIns: Only adds polyfills when used (saves file size).
    corejs: Version of polyfill system to use.
*/  